---
import { getCollection } from 'astro:content';
import Petals from '../components/Petals.astro';
import PostCard from '../components/PostCard.astro';
import SiteTitle from '../components/SiteTitle.astro';
import StickyNote from '../components/StickyNote.astro';
import { GREETING, INTRO, NOW } from '../consts';
import Base from '../layouts/Base.astro';
import { byDateDesc, seasonOf } from '../utils';

const posts = (await getCollection('posts')).sort(byDateDesc);
const season = seasonOf(new Date());
---

<Base home>
	<div class="hero">
		<Petals />
		<header class="hero-inner">
			<div class="greeting">
				<h1><SiteTitle /></h1>
				<p class="hello">{GREETING}</p>
				<p class="intro">{INTRO}</p>
			</div>

			<div class="now-wrap">
				<StickyNote as="aside" color="yellow" tilt={3.5} pinColor="#e07a5f" pinX={44} radius="16px 10px 14px 12px" curl class="now">
					<p class="now-label">{NOW.label}</p>
					<p class="now-text">{NOW.text}</p>
				</StickyNote>
				<span class="season" title={`现在是${season.name}天`}>
					<span aria-hidden="true">{season.flower}</span>
					<span class="season-name">{season.name}</span>
				</span>
			</div>
		</header>
	</div>

	<main class="wall-wrap">
		{
			posts.length === 0 ? (
				<p class="empty">test</p>
			) : (
				<div class="wall">
					{posts.map((post, i) => (
						<PostCard post={post} index={i} />
					))}
				</div>
			)
		}
	</main>
</Base>

<style>
	.hero {
		position: relative;
	}

	.hero-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 32px 48px;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 64px 16px 32px;
	}

	h1 {
		margin: 0 0 18px;
		line-height: 0;
	}

	.hello {
		margin: 0 0 4px;
		font-size: 1.2rem;
	}

	.intro {
		margin: 0;
		color: var(--ink-soft);
	}

	.now-wrap {
		position: relative;
		margin-right: 12px;
	}

	.now-wrap :global(.now) {
		width: 190px;
	}

	.now-label {
		margin: 0 0 2px;
		font-family: var(--font-ui);
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
	}

	.now-text {
		margin: 0;
	}

	/* Round seasonal sticker on the corner of the note */
	.season {
		position: absolute;
		right: -14px;
		bottom: -20px;
		display: grid;
		place-items: center;
		width: 50px;
		height: 50px;
		font-family: var(--font-ui);
		font-size: 0.88rem;
		line-height: 1.1;
		text-align: center;
		color: var(--ink);
		background: var(--note-cream);
		border: 1.5px dashed var(--osmanthus);
		border-radius: 50%;
		transform: rotate(-10deg);
	}

	.season-name {
		font-weight: 700;
	}

	.wall-wrap {
		padding-top: 24px;
	}

	/* Not a grid: cards keep their own widths and offsets so the wall looks hand-stuck */
	.wall {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 22px 30px;
		padding: 16px 12px 0 18px;
	}

	.empty {
		font-family: var(--font-ui);
		color: var(--ink-faint);
	}

	@media (max-width: 600px) {
		.hero-inner {
			padding-top: 44px;
		}

		/* One column on phones; tilt and offsets stay */
		.wall {
			flex-direction: column;
			align-items: center;
			gap: 28px;
			padding: 12px 8px 0;
		}

		.wall :global(.card) {
			width: min(100%, 320px);
			margin-left: 0 !important;
		}
	}
</style>
