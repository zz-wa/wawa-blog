---
import { getCollection } from 'astro:content';
import FlyingButterfly from '../components/FlyingButterfly.astro';
import MarginQuote from '../components/MarginQuote.astro';
import Petals from '../components/Petals.astro';
import PostCard from '../components/PostCard.astro';
import SiteTitle from '../components/SiteTitle.astro';
import Sparkles from '../components/Sparkles.astro';
import StickyNote from '../components/StickyNote.astro';
import { GREETING, INTRO, NOW } from '../consts';
import Base from '../layouts/Base.astro';
import { byDateDesc, seasonOf } from '../utils';

const posts = (await getCollection('posts')).sort(byDateDesc);
// Untitled reading quotes float as bare words left of the wall; everything else is a note on it
const isQuote = (p: (typeof posts)[number]) => p.data.type === 'reading' && !p.data.title;
const quotes = posts.filter(isQuote);
const notes = posts.filter((p) => !isQuote(p));
const season = seasonOf(new Date());
---

<Base home>
	<div class="hero">
		<Petals />
		<Sparkles
			stars={[
				[44, 22, 16, 'yellow', 'star'],
				[52, 60, 10, 'mint', 'star'],
				[58, 30, 12, 'lilac', 'ring'],
				[70, 70, 8, 'pink', 'dot'],
				[8, 82, 12, 'blue', 'star'],
			]}
		/>
		<header class="hero-inner">
			<div class="greeting">
				<h1 class="title-wrap">
					<SiteTitle />
					<img class="bf bf-title" src="/images/deco/butterfly-line.png" alt="" />
				</h1>
				<p class="hello">{GREETING}</p>
				<p class="intro">{INTRO}</p>
			</div>

			<div class="now-wrap">
				<StickyNote as="aside" color="yellow" tilt={3.5} pinColor="#e07a5f" pinX={44} radius="16px 10px 14px 12px" curl class="now">
					<p class="now-label">{NOW.label}</p>
					<p class="now-text">{NOW.text}</p>
				</StickyNote>
				<img class="bf bf-navy" src="/images/deco/butterfly-navy.png" alt="" />
				<span class="season" title={`现在是${season.name}天`}>
					<span aria-hidden="true">{season.flower}</span>
					<span class="season-name">{season.name}</span>
				</span>
			</div>
		</header>
	</div>

	<main class="wall-wrap">
		<Sparkles
			stars={[
				[2, 4, 18, 'yellow', 'star'],
				[30, 1, 10, 'mint', 'star'],
				[47, 62, 14, 'lilac', 'star'],
				[63, 3, 8, 'pink', 'dot'],
				[88, 70, 16, 'blue', 'star'],
				[12, 88, 12, 'mint', 'ring'],
				[74, 40, 9, 'yellow', 'dot'],
				[96, 30, 12, 'pink', 'star'],
			]}
		/>
		<FlyingButterfly />
		<img class="bf bf-corner" src="/images/deco/butterfly-blue-mint.png" alt="" />
		{
			quotes.length > 0 && (
				<aside class="margin-quotes" aria-label="读书摘抄">
					{quotes.map((post, i) => (
						<MarginQuote post={post} index={i} />
					))}
				</aside>
			)
		}
		{
			notes.length === 0 && quotes.length === 0 ? (
				<p class="empty">test</p>
			) : (
				<div class="wall">
					{notes.map((post, i) => (
						<PostCard post={post} index={i} />
					))}
				</div>
			)
		}
	</main>
</Base>

<style>
	.hero {
		position: relative;
	}

	.hero-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 32px 48px;
		max-width: var(--home-width);
		margin: 0 auto;
		padding: 64px 24px 32px;
	}

	h1 {
		margin: 0 0 18px;
		line-height: 0;
	}

	.hello {
		margin: 0 0 4px;
		font-size: 1.2rem;
	}

	.intro {
		margin: 0;
		color: var(--ink-soft);
	}

	.now-wrap {
		position: relative;
		margin-right: 12px;
	}

	.now-wrap :global(.now) {
		width: 190px;
	}

	.now-label {
		margin: 0 0 2px;
		font-family: var(--font-ui);
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
	}

	.now-text {
		margin: 0;
	}

	/* Round seasonal sticker on the corner of the note */
	.season {
		position: absolute;
		right: -14px;
		bottom: -20px;
		display: grid;
		place-items: center;
		width: 50px;
		height: 50px;
		font-family: var(--font-ui);
		font-size: 0.88rem;
		line-height: 1.1;
		text-align: center;
		color: var(--ink);
		background: var(--note-cream);
		border: 1.5px dashed var(--osmanthus);
		border-radius: 50%;
		transform: rotate(-10deg);
	}

	.season-name {
		font-weight: 700;
	}

	/* The home page uses (almost) the whole screen; article pages stay narrow for reading */
	.hero,
	.wall-wrap {
		--home-width: min(1400px, 100%);
	}

	/* Hand-drawn butterflies: one resting on the title, one over the wall's top-right corner */
	.title-wrap {
		position: relative;
		display: inline-block;
	}

	/* Butterflies (illustration: DayDay爱画画, used with permission) — decoration only */
	.bf {
		position: absolute;
		height: auto;
		pointer-events: none;
		user-select: none;
	}

	.bf-title {
		top: -30px;
		right: -86px;
		width: 80px;
		rotate: 10deg;
	}


	.bf-navy {
		top: -34px;
		left: -58px;
		width: 66px;
		rotate: -14deg;
		z-index: 4;
	}

	.bf-corner {
		bottom: 24px;
		left: -6px;
		width: 76px;
		rotate: 14deg;
		z-index: 4;
	}

	/* the line drawing is dark ink: lighten it on the dark moss background */
	@media (prefers-color-scheme: dark) {
		.bf-title {
			filter: invert(0.9) sepia(0.2);
		}
	}


	.wall-wrap {
		position: relative;
		max-width: var(--home-width);
		padding: 24px 24px 96px;
	}

	/* Bare quotes: above the wall on narrow screens, out in the left margin on wide ones */
	.margin-quotes {
		display: flex;
		flex-direction: column;
		gap: 28px;
		max-width: 30em;
		margin: 8px 0 28px 18px;
	}

	/* Wide screens: quotes are a column of upright words down the far right, the wall fills the rest */
	@media (min-width: 1100px) {
		.wall-wrap {
			display: flex;
			align-items: flex-start;
			gap: 40px;
		}

		.margin-quotes {
			/* to the right of the wall */
			order: 2;
			flex: none;
			flex-direction: row-reverse;
			gap: 40px;
			max-width: none;
			margin: 40px 0 0;
		}

		.wall {
			flex: 1;
			min-width: 0;
		}
	}

	/* Not a grid: cards keep their own widths and offsets so the wall looks hand-stuck */
	.wall {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		/* spread the notes over the whole width instead of piling up on the left */
		justify-content: space-around;
		gap: 28px 40px;
		padding: 16px 12px 0 18px;
	}

	.empty {
		font-family: var(--font-ui);
		color: var(--ink-faint);
	}

	@media (max-width: 600px) {
		.hero-inner {
			padding-top: 44px;
		}

		/* One column on phones; tilt and offsets stay */
		.wall {
			flex-direction: column;
			align-items: center;
			gap: 28px;
			padding: 12px 8px 0;
		}

		.wall :global(.card) {
			width: min(100%, 320px);
			margin-left: 0 !important;
		}
	}
</style>
