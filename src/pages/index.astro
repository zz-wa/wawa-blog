---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="page">
			<aside class="intro">
				<h1 class="hello"><span class="marker">Hi, I'm Wa!</span></h1>

				<div class="card-row">
					<div class="avatar" aria-hidden="true">👋</div>
					<div class="side">
						<p class="bubble">欢迎来玩～<br />这里正在慢慢长大。</p>
						<p class="contact">
							<span class="label">GitHub</span>
							<a href="https://github.com/zz-wa" target="_blank" rel="noopener">@zz-wa</a>
						</p>
					</div>
				</div>

				<p class="bio">
					一个正在学写代码的人。在这里记录学到的东西、做过的小项目，和一些日常的碎碎念。
				</p>
			</aside>

			<main class="posts">
				{
					posts.length === 0 ? (
						<div class="empty">
							<p class="eyebrow">Coming soon</p>
							<h2>第一篇文章正在路上</h2>
							<p>还在打草稿，过几天再来看看吧。</p>
						</div>
					) : (
						posts.map((post) => (
							<article class="post">
								<p class="eyebrow">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h2>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<p>{post.data.description}</p>
							</article>
						))
					)
				}
			</main>
		</div>
	</body>
</html>

<style>
	.page {
		display: grid;
		grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
		gap: clamp(40px, 7vw, 110px);
		max-width: 1080px;
		margin: 0 auto;
		padding: clamp(40px, 8vh, 88px) 16px 64px;
	}

	.intro {
		align-self: start;
		position: sticky;
		top: 48px;
	}

	.hello {
		font-size: clamp(2.2rem, 4.2vw, 2.9rem);
		margin-bottom: 1.4rem;
	}

	.card-row {
		display: flex;
		align-items: flex-start;
		gap: 18px;
		margin-bottom: 1.4rem;
	}

	.avatar {
		flex: none;
		display: grid;
		place-items: center;
		width: 118px;
		height: 118px;
		font-size: 64px;
		background: #d3c6c0;
		border-radius: 16px;
		box-shadow: 8px 8px 0 var(--highlight);
		transform: rotate(-2deg);
	}

	.side {
		min-width: 0;
	}

	.bubble {
		position: relative;
		margin: 0 0 1rem;
		padding: 8px 12px;
		font-size: 0.9rem;
		line-height: 1.5;
		border: 2px solid var(--ink);
		border-radius: 12px;
		box-shadow: 3px 3px 0 var(--highlight);
	}

	.bubble::before {
		content: '';
		position: absolute;
		left: -9px;
		bottom: 12px;
		width: 12px;
		height: 12px;
		background: var(--paper);
		border-left: 2px solid var(--ink);
		border-bottom: 2px solid var(--ink);
		transform: rotate(45deg);
	}

	.contact {
		margin: 0;
		font-size: 0.85rem;
	}

	.label {
		margin-right: 6px;
		font-size: 0.72rem;
		color: var(--ink-soft);
	}

	.bio {
		font-size: 1rem;
	}

	.post {
		margin-bottom: 3.2rem;
	}

	.post h2 {
		font-size: clamp(1.6rem, 2.6vw, 2.1rem);
	}

	.post h2 a {
		color: var(--heading);
		font-weight: 800;
		text-decoration: none;
	}

	.post h2 a:hover {
		background: linear-gradient(transparent 58%, var(--highlight) 58%, var(--highlight) 92%, transparent 92%);
	}

	.empty h2 {
		font-size: clamp(1.6rem, 2.6vw, 2.1rem);
	}

	@media (max-width: 820px) {
		.page {
			grid-template-columns: minmax(0, 1fr);
			gap: 48px;
		}

		.intro {
			position: static;
		}
	}
</style>
