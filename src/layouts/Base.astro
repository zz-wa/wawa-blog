---
import BaseHead from '../components/BaseHead.astro';
import SiteTitle from '../components/SiteTitle.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	/** The home page shows the big title itself, so it hides the small one. */
	home?: boolean;
}

const { title, description = SITE_DESCRIPTION, home = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title ? `${title} | ${SITE_TITLE}` : SITE_TITLE} description={description} />
	</head>
	<body>
		{
			!home && (
				<header class="site-header">
					<a href="/" aria-label="回到首页">
						<SiteTitle size="small" />
					</a>
				</header>
			)
		}
		{
			!home && (
				// the colourful butterfly from the home page, landed in the top-right corner
				// (illustration: DayDay爱画画, used with permission)
				<img class="corner-butterfly" src="/images/deco/butterfly-blue-pink.png" alt="" aria-hidden="true" />
			)
		}
		<slot />
	</body>
</html>

<style>
	.site-header {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 28px 16px 0;
	}

	.site-header a {
		display: inline-block;
	}

	.corner-butterfly {
		position: absolute;
		top: 14px;
		right: clamp(12px, 4vw, 56px);
		width: clamp(56px, 7vw, 92px);
		height: auto;
		rotate: -12deg;
		pointer-events: none;
		user-select: none;
	}
</style>
