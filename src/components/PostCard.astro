---
// 墙上的一张。整张都能点，点进去是这一篇的完整页面。
// - 有 title 的长文：只显示标题和正文开头约 40 个字，不显示图片
// - 短的：完整显示
// - 读书：带“读书”标记，有书名就显示《书名》，末尾署作者
import { render } from 'astro:content';
import {
	excerpt,
	formatDate,
	NOTE_SHORT_LIMIT,
	plainText,
	type Post,
	postHref,
	wallLook,
} from '../utils';
import StickyNote from './StickyNote.astro';
import Whisper from './Whisper.astro';

interface Props {
	post: Post;
	index: number;
}

const { post, index } = Astro.props;
const look = wallLook(post, index);
const href = postHref(post);
const { Content } = await render(post);
const { title, author, date } = post.data;
const book = post.data.type === 'reading' ? post.data.book : undefined;
const summary = post.data.type === 'reading' ? post.data.summary : undefined;

// Untitled notes that run long still get clipped instead of filling the wall
const clipped = !title && plainText(post).length > NOTE_SHORT_LIMIT;
const label = title ?? (book ? `读书：《${book}》` : `${post.data.type === 'reading' ? '读书' : '碎碎念'} ${formatDate(date)}`);

// Inline, because these land on StickyNote's root element where this file's scoped CSS can't reach
const style = [
	`width: ${look.width}px`,
	'max-width: 100%',
	// Real sticky notes are square; a long one still grows taller to fit its text
	post.data.type === 'note' ? 'aspect-ratio: 1 / 0.94' : '',
	`translate: ${look.dx}px ${look.dy}px`,
	`margin-top: ${look.marginTop}px`,
	`margin-left: ${look.marginLeft}px`,
].filter(Boolean).join('; ');
---

<StickyNote
	as="article"
	class="card"
	color={look.color}
	tilt={look.tilt}
	pinColor={look.pinColor}
	pinX={look.pinX}
	radius={look.radius}
	curl={look.curl}
	style={style}
>
	{/* Covers the whole note so any spot opens the post; whisper dots sit above it */}
	<a class="card-link" href={href} aria-label={label}></a>
	{post.data.type === 'reading' && <span class="tag">读书</span>}
	<time class="meta" datetime={date.toISOString()}>{formatDate(date)}</time>
	{book && <h2 class="book">《{book}》</h2>}
	{
		title ? (
			<>
				<h2 class="title">{title}</h2>
				<p class="excerpt">{excerpt(post, 40)}</p>
				{post.data.cover && <img class="cover" src={post.data.cover} alt="" loading="lazy" />}
				<span class="more" aria-hidden="true">
					读完 →
				</span>
			</>
		) : summary ? (
			<p class="excerpt">{summary}</p>
		) : (
			<div class:list={['body', { clipped }]}>
				<Content components={{ Whisper }} />
			</div>
		)
	}
	{clipped && (
		<span class="more" aria-hidden="true">
			读完 →
		</span>
	)}
	{author && <p class="author">—— {author}</p>}
</StickyNote>

<style>
	.card-link {
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: inherit;
	}

	.card-link:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 3px;
	}

	/* Keep whisper dots clickable on top of the card link */
	.body :global(.whisper-dot) {
		position: relative;
		z-index: 2;
	}

	:global(.card) {
		cursor: pointer;
	}

	.meta {
		display: block;
		font-family: var(--font-ui);
		font-size: 0.88rem;
		letter-spacing: 0.03em;
		color: var(--ink-faint);
	}

	time.meta {
		margin-bottom: 4px;
	}


	.body :global(p) {
		margin: 0 0 0.5em;
	}

	.body :global(p:last-child) {
		margin-bottom: 0;
	}

	/* Pictures only show on the full post page, never on the wall */
	.body :global(img) {
		display: none;
	}

	.clipped {
		max-height: 9.2em;
		overflow: hidden;
		mask-image: linear-gradient(#000 62%, transparent);
	}

	.more {
		display: inline-block;
		margin-top: 6px;
		font-family: var(--font-ui);
		font-size: 0.88rem;
		color: var(--link);
	}

	/* "读书" as two loose characters floating down the card's left edge, no box */
	.tag {
		position: absolute;
		top: 14px;
		left: -1.5em;
		writing-mode: vertical-rl;
		letter-spacing: 0.35em;
		font-size: 0.95rem;
		color: var(--link);
		rotate: -4deg;
		pointer-events: none;
	}

	.book,
	.title {
		margin: 2px 0 4px;
		font-size: 1.25rem;
		line-height: 1.4;
	}

	.excerpt {
		margin: 0;
		color: var(--ink-soft);
	}

	/* The post's cover photo, as a small print tucked into the note */
	.cover {
		display: block;
		width: 78%;
		aspect-ratio: 4 / 3;
		margin: 12px auto 4px;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid var(--note-edge);
		rotate: -2deg;
	}

	/* Hard line breaks (trailing \ in Markdown) come through as <br>; keep them tight on the wall */
	.body :global(br) {
		line-height: 1.6;
	}

	.author {
		margin: 8px 0 0;
		text-align: right;
		color: var(--ink-soft);
	}

	:global(.card):hover .book,
	:global(.card):hover .title,
	:global(.card):hover .more {
		color: var(--link);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
</style>
