---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} />
	</head>

	<body>
		<div class="wrap">
			<a class="home" href="/"><span class="marker">{SITE_TITLE}</span></a>

			<article>
				<header class="head">
					<p class="eyebrow">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span>
									· updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</p>
					<h1>{title}</h1>
				</header>

				{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}

				<div class="prose">
					<slot />
				</div>
			</article>

			<a class="back" href="/">← 回到首页</a>
		</div>
	</body>
</html>

<style>
	.wrap {
		max-width: 720px;
		margin: 0 auto;
		padding: 28px 16px 72px;
	}

	.home {
		color: var(--heading);
		font-weight: 800;
		text-decoration: none;
	}

	.home:hover {
		background: none;
	}

	.head {
		margin: clamp(48px, 9vh, 88px) 0 2rem;
	}

	.head h1 {
		font-size: clamp(2rem, 5vw, 3rem);
	}

	.hero {
		display: block;
		width: 100%;
		margin-bottom: 2rem;
	}

	.prose :global(h2) {
		margin-top: 2em;
		font-size: 1.6rem;
	}

	.prose :global(h3) {
		margin-top: 1.6em;
		font-size: 1.3rem;
	}

	.back {
		display: inline-block;
		margin-top: 3rem;
		font-size: 0.9rem;
	}
</style>
