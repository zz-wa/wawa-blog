---
// 预览：朋友版本的左边固定栏 + 右边放我们自己的弯曲绳子（不是直的时间线）。
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import FlyingButterfly from '../components/FlyingButterfly.astro';
import RopeTimeline from '../components/RopeTimeline.astro';
import SideQuote from '../components/SideQuote.astro';
import { STANDALONE_POSTS } from '../consts';
import ropeData from '../data/rope.json';
import Journal from '../layouts/Journal.astro';
import { byDateDesc } from '../utils';

export const getStaticPaths = (async ({ paginate }) => {
	// 单独拿出来的几条不挂在绳子上；其余按日期从新到旧，一页挂 rope.json 里球钉那么多张
	const posts = (await getCollection('posts')).filter((p) => !STANDALONE_POSTS.some((q) => q.id === p.id)).sort(byDateDesc);
	// 不分页：所有文章都在这一页，绳子挂满了就接着再开一圈
	return paginate(posts, { pageSize: 1000 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const onRope = page.data;
// 单独拿出来的几句，放在左边栏“最近在读”的下面
const all = await getCollection('posts');
const quotes = STANDALONE_POSTS.flatMap(({ id }) => {
	const post = all.find((p) => p.id === id);
	return post ? [{ post, side: 'right' as const }] : [];
});
---

<Journal shelf="notes">
	{page.currentPage === 1 && <SideQuote slot="side" posts={quotes} where="side" />}
	<div class="rope-area">
		<div class="rest"><span class="perch-rest" data-perch aria-hidden="true"></span><FlyingButterfly /></div>
		<RopeTimeline posts={onRope} />
		{(page.url.prev || page.url.next) && (
			<nav class="pager" aria-label="翻页">
				{page.url.next ? <a href={page.url.next}>← 更早的</a> : <span />}
				{page.url.prev ? <a href={page.url.prev}>更新的 →</a> : <span />}
			</nav>
		)}
	</div>
</Journal>

<style>
	.rope-area {
		position: relative;
		max-width: 980px;
	}

	/* 绳子画布最上面有一块留给标题区的空白，原首页让绳子往上叠进标题区；这里没有标题区，不用上拉 */
	.rope-area :global(.rope--wide:not(.rope--next)) {
		margin-top: calc(-40 / 700 * 100%);
	}

	/* 蝴蝶停在右上角的空地里 */
	.rest {
		position: absolute;
		right: 0;
		top: 0;
		width: 180px;
		height: 90px;
	}

	.pager {
		display: flex;
		justify-content: space-between;
		margin-top: 40px;
		font-size: 0.95rem;
	}

	.perch-rest {
		position: absolute;
		right: 10%;
		bottom: -20%;
		width: 8px;
		height: 8px;
	}
</style>
